# Copy this file to 03-download.env (git-ignored: *.env) and fill it in.
# Read as plain KEY=value data by 03-download-v2.sh - it is never executed.

# Credentials (optional - leave empty to be prompted only if the site asks)
DEV04_USER=
DEV04_PASS=

# Where to save the files
DOWNLOAD_DIR=./downloads

# The list of links: a text or JSON file, relative to this env file
LINKS_FILE=03-download.links.txt

# Or put links here directly (space or comma separated)
# LINKS=https://dev04.dev.bizmates.jp/a.zip https://dev04.dev.bizmates.jp/b.zip

# One sub-folder per label ("May data", "June data", ...): 1 = yes
GROUP=0
